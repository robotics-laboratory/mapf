load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "solvers",
    srcs = glob(["solvers/src/*.cpp"]),
    hdrs = glob(["solvers/include/solvers/*.h"]),
    includes = ["solvers/include"],
    deps = [
        "//graph",
        "//models",
    ],
)

cc_library(
    name = "factory",
    srcs = glob(["factory/src/*.cpp"]),
    hdrs = glob(["factory/include/factory/*.h"]),
    includes = ["factory/include"],
    deps = [
        ":solvers",
    ],
)

cc_binary(
    name = "main",
    srcs = ["main/src/main.cpp"],
    deps = [
        ":factory",
        ":solvers",
        "@boost.program_options",
    ],
)

cc_binary(
    name = "export_solution",
    srcs = ["tools/src/export_solution.cpp"],
    deps = [
        ":factory",
        ":solvers",
        "//graph",
        "//models",
    ],
)

cc_test(
    name = "solvers_tests",
    size = "large",
    srcs = glob(["tests/*.cpp"]),
    deps = [
        ":solvers",
        "//graph",
        "//models",
        "//models:models_test",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)
